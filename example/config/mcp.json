{
  "mcpServers": {
    "schedules": {
      "type": "http",
      "url": "http://localhost:9400/mcp",
      "headers": {
        "X-Agent-Name": "${CLAUB_AGENT_NAME}"
      }
    },
    "nextcloud": {
      "command": "uv",
      "args": ["--directory", "/app/mcps/nextcloud", "run", "server.py"]
    },
    "git": {
      "command": "uv",
      "args": ["--directory", "/app/mcps/git", "run", "server.py"]
    },
    "hass": {
      "command": "uv",
      "args": ["--directory", "/app/mcps/hass", "run", "server.py"]
    }
  }
}
